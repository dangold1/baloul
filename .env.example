# Google Tag Manager container ID (e.g. GTM-XXXXXXX).
# GA4, Google Ads conversions and Meta Pixel are all configured inside GTM.
# Leave empty until the account exists: nothing is loaded and no cookies are set.
NEXT_PUBLIC_GTM_ID=

# Google Search Console verification token (the content value of the meta tag Google gives you).
# The tag is rendered on every page only when this is set.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
